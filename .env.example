# Japan Startups Fund Raising & M&A Digest
# 環境変数設定ファイル
# このファイルを .env にコピーして、実際の値を設定してください

# ===========================================
# 必須設定
# ===========================================

# Claude API (要約生成用)
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxx

# メール配信 (Resend)
# https://resend.com/ で取得
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=digest@yourdomain.com
EMAIL_TO=your-email@example.com

# ===========================================
# オプション設定（有料サービス）
# ===========================================

# 日経電子版（有料会員アカウント）
NIKKEI_EMAIL=
NIKKEI_PASSWORD=

# Crunchbase API
# https://data.crunchbase.com/ で取得
CRUNCHBASE_API_KEY=

# NewsPicks（有料会員アカウント）
NEWSPICKS_EMAIL=
NEWSPICKS_PASSWORD=

# ===========================================
# システム設定（通常は変更不要）
# ===========================================

# データベース
DATABASE_URL=sqlite:///data/startup_news.db

# スクレイピング設定
REQUEST_TIMEOUT=30
REQUEST_DELAY=1.0

# 要約設定
SUMMARY_MODEL=claude-sonnet-4-20250514
MAX_ARTICLES_PER_DIGEST=50
